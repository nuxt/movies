  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "nuxt build",
    "dev:proxy": "cd proxy && pnpm dev",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "nuxt prepare",
    "start": "node .output/server/index.mjs",
