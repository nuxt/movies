    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.94",
    "@iconify-json/twemoji": "^1.2.5",
    "@nuxt/image": "^2.1.0",
    "@nuxt/test-utils": "^4.2.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@unocss/nuxt": "^66.9.2",
    "@vitest/coverage-v8": "4.1.11",
